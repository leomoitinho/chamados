# Configuração da Aplicação
PROJECT_NAME="Sistema de Chamados Multi-Empresas"
SECRET_KEY="chamados_super_secret_jwt_key_2026_antigravity_secure_token"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Conexão MySQL (Produção / Desenvolvimento)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=chamados_db

# String de Conexão (Caso queira usar SQLite para testes rápidos locais, defina: sqlite:///./chamados.db)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/chamados_db?charset=utf8mb4
# DATABASE_URL=sqlite:///./chamados.db
